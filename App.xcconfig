PRODUCT_NAME = $(TARGET_NAME)
BREEZEPILOT_BUNDLE_ID = local.daikin.directcontrol
BREEZEPILOT_APP_GROUP = group.$(BREEZEPILOT_BUNDLE_ID)
PRODUCT_BUNDLE_IDENTIFIER = $(BREEZEPILOT_BUNDLE_ID)
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0

CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Info.plist
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

ALWAYS_SEARCH_USER_PATHS = NO

CODE_SIGN_ENTITLEMENTS = BreezePilot.entitlements
#include? "BreezePilot.local.xcconfig"
